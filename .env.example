# Go Daily environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Application ---
# development | test | staging | production
APP_ENV=development
APP_TIMEZONE=Africa/Cairo
LOG_LEVEL=INFO
# true in staging/production
LOG_JSON=false

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=godaily
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=godaily
POSTGRES_PORT=5432

# --- API ---
# Used when running the API outside Docker (e.g. `make api-dev`).
DATABASE_URL=postgresql+psycopg://godaily:change-me-local-only@localhost:5432/godaily
# Test database (tests DROP and recreate its schema).
TEST_DATABASE_URL=postgresql+psycopg://godaily:change-me-local-only@localhost:5432/godaily_test
CORS_ORIGINS=http://localhost:3000
API_PORT=8000

# Session lifetimes (opaque server-side sessions).
SESSION_TTL_HOURS_ADMIN=12
SESSION_TTL_HOURS_DRIVER=720
SESSION_IDLE_TIMEOUT_HOURS=72
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# One-time bootstrap of the first SUPER_ADMIN (`make bootstrap-admin`).
# Remove the password from the environment after the account exists.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=مدير النظام

# --- Attachments (receipts, statements, invoices) ---
# local: files on disk (STORAGE_LOCAL_ROOT; a Docker volume in compose).
# s3: any S3-compatible service (AWS S3, Cloudflare R2, MinIO...). Objects
# stay private and are served only through the API after a permission check.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/attachments
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=
# Leave empty to use the platform's credential chain (instance role, etc.).
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_BYTES=10485760

# --- Admin web ---
WEB_PORT=3000
# Server-side URL the admin web uses to reach the API.
API_INTERNAL_URL=http://localhost:8000
# Must be true when served over HTTPS (staging/production).
SESSION_COOKIE_SECURE=false
